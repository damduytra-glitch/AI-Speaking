# =========================================================
# Vercel Ignore Configuration
# Chặn toàn bộ file bảo mật, AI models, Python Backend & Data
# để dung lượng deploy của Vercel chỉ còn ~450KB
# =========================================================

# Secrets & Local Configs
.env
.env.*
!.env.example
kaggle.json
.kaggle/
*.pem
*.key

# Next.js build cache & dependencies (built fresh on Vercel)
web/.next/
web/node_modules/
web/out/
web/tsconfig.tsbuildinfo
web/next-env.d.ts

# Machine Learning & AI Models (Đã chạy trên Kaggle GPU)
web/models/
transformer_models/
speaker-diarize/
pretrained_models/
checkpoints/
*.pt
*.pth
*.safetensors
*.bin
*.onnx
*.ckpt
*.tar*

# Python Backend, Scripts & Tests
*.py
*.ipynb
*.sql
requirements*.txt
classroom_lang/
configs/
infer/
models/
scripts/
tests/
supabase/
venv/
.venv/
venv_dfn/
__pycache__/
*.pyc

# Tài liệu & Dữ liệu
docs/
data/
sample_audio/
*.docx
*.pdf
logs/
tmp_*/
.hf_tmp_cache/
hf_cache/
thesis-generator/

# Git & Agent metadata
.git/
.github/
.gitignore
.agents/
